import json
import re

def buscar_profesores_por_asignatura(query, json_path="teachers.json"):
    with open(json_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    
    query_limpia = query.strip().lower()
    resultados = []

    for profesor in data.get("teachers", []):
        encontrado = False
        for asignatura in profesor.get("subjects", []):
            asignatura_lower = asignatura.lower()
            
            # 1. Coincidencia exacta o parcial (ej: "sistemas" encuentra "Sistemas operativos I")
            if query_limpia in asignatura_lower:
                encontrado = True
                break
            
            # 2. Coincidencia por abreviatura simple (ej: "SO" -> "Sistemas Operativos")
            # Extrae las iniciales de la asignatura
            iniciales = "".join([palabra[0] for palabra in asignatura_lower.split() if palabra])
            if query_limpia in iniciales or query_limpia == iniciales:
                encontrado = True
                break
                
        if encontrado:
            resultados.append(profesor)

    return resultados

# --- Ejemplo de uso ---
if __name__ == "__main__":
    # Puedes buscar por nombre parcial ("operativos") o por abreviatura ("so")
    query = "so" 
    print(f"Buscando asignaturas que coincidan con: '{query}'\n")
    
    profesores = buscar_profesores_por_asignatura(query)
    for p in profesores:
        print(f"- {p['name']} | Materias: {p['subjects']}")